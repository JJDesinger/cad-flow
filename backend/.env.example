# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cad_flow
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=8h

# Email — escolha uma das opções abaixo e preencha com suas credenciais

# Opção 1: Gmail
# 1. Ative a verificação em duas etapas na conta Google
# 2. Gere uma Senha de App: myaccount.google.com/apppasswords
# 3. Use a senha gerada no campo SMTP_PASS (não a senha normal da conta)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# Opção 2: Outlook / Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=seu_email@outlook.com
# SMTP_PASS=sua_senha

# Deixe em branco para desabilitar e-mails (logs no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
